{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "ReceiptObjects",
            "Effect": "Allow",
            "Action": [
                "s3:PutObject",
                "s3:GetObject",
                "s3:DeleteObject"
            ],
            "Resource": "arn:aws:s3:::receipts-recurring-673787498952-ap-southeast-2-an/receipts/*"
        },
        {
            "Sid": "ListReceiptPrefix",
            "Effect": "Allow",
            "Action": "s3:ListBucket",
            "Resource": "arn:aws:s3:::receipts-recurring-673787498952-ap-southeast-2-an",
            "Condition": {
                "StringLike": {
                    "s3:prefix": [
                        "receipts/*"
                    ]
                }
            }
        }
    ]
}
